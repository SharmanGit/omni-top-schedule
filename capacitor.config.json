{
  "appId": "ru.topacademy.omni",
  "appName": "Omni TOP",
  "webDir": "public",
  "server": {
    "androidScheme": "http",
    "cleartext": true
  },
  "backgroundColor": "#0c1322",
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "CapacitorCookies": {
      "enabled": true
    },
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#0c1322",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    }
  }
}
